{
  "name": "wheretodump",
  // Lavai Labs account — pinned so deploys can never hit the old account
  "account_id": "d42538cebc7d337a0c0769a11f261ea5",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "wheretodump.com", "custom_domain": true },
    { "pattern": "www.wheretodump.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      // Create before first remote deploy: `npx wrangler r2 bucket create wheretodump-inc-cache`
      "bucket_name": "wheretodump-inc-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wheretodump-db",
      "database_id": "46c3f459-12ab-472b-a784-757debc20e62"
    }
  ]
}
