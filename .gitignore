# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / opennext
.open-next/
.wrangler/

# data pipeline: ignore raw scrapes, keep the durable dataset
# (merged facilities + image map are what rebuilds D1)
outscraper-data/*
!outscraper-data/*-merged-facilities.json
!outscraper-data/cf-images-map.json
scripts/data-pipeline/chrome-profile/
scripts/data-pipeline/google-cookies.txt

# generated SQL (rebuild via scripts/import-facilities.ts etc.)
db/import-*.sql
db/update-*.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# generated
src/lib/guide-registry.generated.ts

# enrichment source downloads (re-fetch per script header comments)
enrichment-data/
