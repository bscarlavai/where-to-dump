{
  "name": "where-to-dump",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:guides": "tsx scripts/generate-guide-registry.ts",
    "ingest": "tsx scripts/ingest/run.ts",
    "photos": "tsx scripts/images/upload-photos.ts",
    "score": "tsx scripts/review/score-facilities.ts",
    "dev": "npm run generate:guides && next dev",
    "build": "npm run generate:guides && next build",
    "start": "next start",
    "lint": "eslint",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:only": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "enrich:lmop": "tsx scripts/enrich/lmop.ts",
    "enrich:idem": "tsx scripts/enrich/idem.ts",
    "build:cf": "npx wrangler d1 execute wheretodump-db --local --file=db/production-schema.sql && npx wrangler d1 execute wheretodump-db --local --file=db/production-data.sql && npm run build:worker",
    "enrich:ohio": "tsx scripts/enrich/ohio-epa.ts",
    "enrich:illinois": "tsx scripts/enrich/illinois-epa.ts",
    "enrich:michigan": "tsx scripts/enrich/michigan-egle.ts",
    "push:production": "tsx scripts/deploy/push-production.ts",
    "enrich:pa": "tsx scripts/enrich/pa-dep.ts",
    "enrich:ny": "tsx scripts/enrich/ny-dec.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "@tailwindcss/typography": "^0.5.19",
    "csv-parse": "^6.2.1",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "next": "16.2.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "tsx": "^4.21.0",
    "wrangler": "^4.78.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
